<Window x:Class="LumeaCopiilor.StatisticiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Statistici"
        WindowState="Maximized"
        Background="{StaticResource LightColor}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="80,60,80,60">

            <Grid Margin="0,0,0,48">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="Statistici"/>
                    <TextBlock Style="{StaticResource P}"
                               Text="Rapoarte și date despre activitatea magazinului"
                               Margin="4,-12,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Înapoi la panou"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="Inapoi_Click"/>
            </Grid>

            <TextBlock Text="Exportați rapoarte"
                       Style="{StaticResource P}"
                       Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,0"
                        Click="ExportCumparaturiWord_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📄"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Cumpărături"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock Text="în Word (.docx)"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="13"
                                   Foreground="{StaticResource Paragraph}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,0"
                        Click="ExportCumparaturiExcel_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Cumpărături"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock Text="în Excel (.xlsx)"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="13"
                                   Foreground="{StaticResource Paragraph}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,0"
                        Click="ExportProduseExcel_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📦"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Toate produsele"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock Text="în Excel (.xlsx)"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="13"
                                   Foreground="{StaticResource Paragraph}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Style="{StaticResource AdminButton}"
                        Click="ExportFaraStocExcel_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠️"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Produse fără stoc"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock Text="în Excel (.xlsx)"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="13"
                                   Foreground="{StaticResource Paragraph}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="Date despre activitate"
                       Style="{StaticResource P}"
                       Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Cele mai populare produse"
                               Style="{StaticResource P}"
                               Margin="0,0,0,8"/>
                    <Border CornerRadius="12"
                            BorderBrush="{StaticResource Placeholder}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Margin="0,0,0,32">
                        <DataGrid x:Name="ProdusePopulareGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="420"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produs"
                                                    Binding="{Binding Nume}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Categorie"
                                                    Binding="{Binding Categorie}"
                                                    Width="Auto"/>
                                <DataGridTextColumn Header="Total vândut (buc.)"
                                                    Binding="{Binding TotalVandut}"
                                                    Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Text="Utilizatori cu cele mai multe cumpărături"
                               Style="{StaticResource P}"
                               Margin="0,0,0,8"/>
                    <Border CornerRadius="12"
                            BorderBrush="{StaticResource Placeholder}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <DataGrid x:Name="TopUtilizatoriGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="420"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Utilizator"
                                                    Binding="{Binding NumeComplet}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Email"
                                                    Binding="{Binding Email}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Nr. comenzi"
                                                    Binding="{Binding NrComenzi}"
                                                    Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </StackPanel>

               <StackPanel Grid.Column="2">

                    <TextBlock Text="Administratori"
                               Style="{StaticResource P}"
                               Margin="0,0,0,8"/>
                    <Border CornerRadius="12"
                            BorderBrush="{StaticResource Placeholder}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Margin="0,0,0,32">
                        <DataGrid x:Name="AdministratoriGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="420"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Utilizator"
                                                    Binding="{Binding NumeUtilizator}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Nume complet"
                                                    Binding="{Binding NumeComplet}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Email"
                                                    Binding="{Binding Email}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Text="Cele mai puțin populare produse"
                               Style="{StaticResource P}"
                               Margin="0,0,0,8"/>
                    <Border CornerRadius="12"
                            BorderBrush="{StaticResource Placeholder}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <DataGrid x:Name="ProduseNepopulareGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="420"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produs"
                                                    Binding="{Binding Nume}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Categorie"
                                                    Binding="{Binding Categorie}"
                                                    Width="Auto"/>
                                <DataGridTextColumn Header="Total vândut (buc.)"
                                                    Binding="{Binding TotalVandut}"
                                                    Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
