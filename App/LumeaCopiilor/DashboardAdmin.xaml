<Window x:Class="LumeaCopiilor.DashboardAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LumeaCopiilor"
        mc:Ignorable="d"
        Title="Admin Dashboard"
        WindowState="Maximized"
        Background="{StaticResource LightColor}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="80,60,80,60">

            <Grid Margin="0,0,0,40">
                <TextBlock Style="{StaticResource H1}"
                           Text="Bine ați revenit!"
                           HorizontalAlignment="Left"/>
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Închidere program"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="Close_Click"/>
            </Grid>

            <Grid Margin="0,0,0,48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,0"
                        Click="AddNewProduct_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🧸"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Înregistrați o nouă jucărie"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,0"
                        Click="AddNewUser_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👤"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Adăugați un nou utilizator"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Style="{StaticResource AdminButton}"
                        Margin="0,0,12,0"
                        Click="SearchToy_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔍"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Căutați o jucărie"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource AdminButton}"
                        Click="ViewStats_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📈"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Accesați statisticile"
                                   HorizontalAlignment="Center"
                                   FontFamily="Montserrat"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="850"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Produsele din magazin"
                               Style="{StaticResource P}"
                               Margin="0,0,0,8"/>
                    <Border CornerRadius="12"
                        BorderBrush="{StaticResource Placeholder}"
                        BorderThickness="1"
                        ClipToBounds="True">
                        <DataGrid x:Name="ProductsGrid"
                                  MouseDoubleClick="ProductsGrid_MouseDoubleClick"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="850"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"
                                Binding="{Binding Name}"
                                Width="*"/>
                                <DataGridTextColumn Header="Price"
                                Binding="{Binding Price}"
                                Width="Auto"/>
                                <DataGridTextColumn Header="Category"
                                Binding="{Binding Category}"
                                Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Utilizatorii actuali"
               Style="{StaticResource P}"
               Margin="0,0,0,8"/>
                    <Border CornerRadius="12"
            BorderBrush="{StaticResource Placeholder}"
            BorderThickness="1"
            ClipToBounds="True"
            Margin="0,0,0,32">
                        <DataGrid x:Name="UsersGrid"
                                  MouseDoubleClick="UsersGrid_MouseDoubleClick"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MaxHeight="400"
                  HeadersVisibility="Column"
                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*"/>
                                <DataGridTextColumn Header="Password"
                                    Binding="{Binding Password}"
                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Text="Importatori"
               Style="{StaticResource P}"
               Margin="0,0,0,8"/>
                    <Border CornerRadius="12"
            BorderBrush="{StaticResource Placeholder}"
            BorderThickness="1"
            ClipToBounds="True">
                        <DataGrid x:Name="ImportersGrid"
                                  MouseDoubleClick="ImportersGrid_MouseDoubleClick"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  MaxHeight="400"
                  HeadersVisibility="Column"
                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Oraș" Binding="{Binding City}" Width="*"/>
                                <DataGridTextColumn Header="Țară" Binding="{Binding Country}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>