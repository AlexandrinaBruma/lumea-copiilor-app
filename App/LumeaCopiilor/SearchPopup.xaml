<Window x:Class="LumeaCopiilor.SearchPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="480"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource LightColor}"
            CornerRadius="16"
            Padding="40">
        <StackPanel>

            <TextBlock Style="{StaticResource H1}"
                       Text="Căutați o jucărie"
                       FontSize="26"
                       LineHeight="26"
                       Margin="0,0,0,24"/>

            <TextBox x:Name="SearchInput"
                     Height="52"
                     Margin="0,0,0,16"
                     KeyDown="SearchInput_KeyDown"/>

            <ScrollViewer x:Name="ResultsScrollViewer"
                          MaxHeight="260"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,16"
                          Visibility="Collapsed">
                <StackPanel x:Name="ResultsPanel"/>
            </ScrollViewer>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="0"
                        Content="Înapoi"
                        Click="Inapoi_Click"/>
                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="0"
                        Content="Caută"
                        Click="Cauta_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
