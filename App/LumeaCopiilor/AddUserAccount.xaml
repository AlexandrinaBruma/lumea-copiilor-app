<Window x:Class="LumeaCopiilor.AddUserAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d xctk"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LumeaCopiilor"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Creazăți un cont"
        WindowState="Maximized"
        Background="{StaticResource LightColor}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60" HorizontalAlignment="Center">

                <Grid Margin="0,0,0,50">
                    <TextBlock Text="Creazăți un cont" 
                               Style="{StaticResource H1}"
                               HorizontalAlignment="Center"/>
                </Grid>

                <!-- USERNAME SI PASSWORD -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Username" 
                                   Style="{StaticResource P}"
                                   FontSize="24"
                                   Margin="0,0,0,10"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Text="{Binding User.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Grid Grid.Column="1"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Password" 
                                   Style="{StaticResource P}"
                                   FontSize="24"
                                   Margin="0,0,0,10"/>
                        <TextBox x:Name="PasswordTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Text="{Binding User.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- NUME SI PRENUME -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nume" 
                                   Style="{StaticResource P}"
                                   FontSize="24"
                                   Margin="0,0,0,10"/>
                        <TextBox x:Name="NumeTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Text="{Binding User.Nume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Grid Grid.Column="1"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Prenume" 
                                   Style="{StaticResource P}"
                                   FontSize="24"
                                   Margin="0,0,0,10"/>
                        <TextBox x:Name="PrenumeTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Text="{Binding User.Prenume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- DATA NASTERII SI EMAIL -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Data nașterii" 
                   Style="{StaticResource P}"
                   FontSize="24"
                   Margin="0,0,0,10"/>
                        <Border BorderBrush="{StaticResource DarkColor}"
        BorderThickness="1.5"
        CornerRadius="30"
        Background="{StaticResource LightColor}"
        MinHeight="60">
                            <xctk:DateTimePicker x:Name="DataNasterii"
                         Format="Custom"
                         FormatString="dd/MM/yyyy"
                         TimePickerVisibility="Collapsed"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="20,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Value="{Binding User.DataNasterii, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" 
                   Style="{StaticResource P}"
                   FontSize="24"
                   Margin="0,0,0,10"/>
                        <TextBox x:Name="EmailTextBox"
                 Style="{StaticResource InputStyle}"
                 Text="{Binding User.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Numărul de telefon" 
                                   Style="{StaticResource P}"
                                   FontSize="24"
                                   Margin="0,0,0,10"/>
                        <TextBox x:Name="TelefonTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Text="{Binding User.Telefon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Grid Grid.Column="1"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Genul" 
                                   Style="{StaticResource P}"
                                   Margin="0,0,0,10"
                                   FontSize="24"/>
                        <ComboBox x:Name="GenulComboBox"
                                  Style="{StaticResource ComboBoxStyle}"
                                  SelectedValue="{Binding User.Genul, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem>Masculin</ComboBoxItem>
                            <ComboBoxItem>Feminin</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- ORASUL -->
                <Grid Margin="0,0,0,50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Orașul" 
                                   Style="{StaticResource P}"
                                   FontSize="24"
                                   Margin="0,0,0,10"/>
                        <ComboBox x:Name="OrasulComboBox"
                                  Style="{StaticResource ComboBoxStyle}"
                                  SelectedValue="{Binding User.Oras, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem>Chisinau</ComboBoxItem>
                            <ComboBoxItem>Bucuresti</ComboBoxItem>
                            <ComboBoxItem>Cluj-Napoca</ComboBoxItem>
                            <ComboBoxItem>Iasi</ComboBoxItem>
                            <ComboBoxItem>Berlin</ComboBoxItem>
                            <ComboBoxItem>Shanghai</ComboBoxItem>
                            <ComboBoxItem>Paris</ComboBoxItem>
                            <ComboBoxItem>Varsovia</ComboBoxItem>
                            <ComboBoxItem>Istanbul</ComboBoxItem>
                            <ComboBoxItem>Milano</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <Grid Grid.Column="1"/>
                    <Grid Grid.Column="2"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1020"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="Anulare"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="160"
                            MinHeight="50"
                            Click="Anulare_Click"/>

                    <Grid Grid.Column="2"/>

                    <Button Grid.Column="3"
                            Content="Creează"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="160"
                            MinHeight="50"
                            Click="CreateButton_Click"/>
                </Grid>

                <Image Source="/Assets/bottom-img.png"
                       Margin="0, 70, 0, 0"
                        Stretch="UniformToFill"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"/>
            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>