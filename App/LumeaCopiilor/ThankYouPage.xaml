<Window x:Class="LumeaCopiilor.ThankYouPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LumeaCopiilor"
        Title="Multumim pentru cumparatura"
        WindowState="Maximized"
        Background="{StaticResource LightColor}">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Mulțumim pentru" 
                       Style="{StaticResource H1}"
                       HorizontalAlignment="Center"
                       FontSize="70"
                       Margin="0,0,0,0"/>

            <TextBlock Text="cumpărătură!" 
                       Style="{StaticResource H1}"
                       HorizontalAlignment="Center"
                       FontSize="70"
                       Margin="0,0,0,50"/>

            <Image Source="/Assets/cart.png"
                   Height="270"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,60"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,0">

                <Button Content="Închidere"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,16,0"
                        Click="InchidereButton_Click"/>

                <Button Content="Înapoi la home"
                        Style="{StaticResource PrimaryButton}"
                        Margin="16,0,0,0"
                        Click="InapoiButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>

</Window>