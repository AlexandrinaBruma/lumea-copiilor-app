<Window x:Class="LumeaCopiilor.NewProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LumeaCopiilor"
        Title="Produs nou"
        WindowState="Maximized"
        Background="{StaticResource LightColor}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource H1}"
                       Text="Adăugați"
                       HorizontalAlignment="Center"
                       Margin="0,80,0,48"/>

            <Grid Grid.Row="1" Margin="80,0,80,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Nume" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="NameInput"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Categoria" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="CategoryInput"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="80,0,80,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Vârsta minimă recomandată" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="MinAgeInput"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Vârsta maximă" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="MaxAgeInput"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="80,0,80,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Data fabricației" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="ManufactureDateInput"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Data expirării" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="ExpiryDateInput"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="80,0,80,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Preț" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="PriceInput"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Țara de origine" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="CountryInput"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="5" Margin="80,0,80,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Importator" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="ImporterInput"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Cantitatea disponibilă" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <TextBox x:Name="QuantityInput"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="6" Margin="80,0,80,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Center"
                            Width="300">
                    <TextBlock Text="Filiala disponibilă" Style="{StaticResource P}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="BranchInput" Style="{StaticResource ComboBoxStyle}">
                        <ComboBoxItem Content="Toate"/>
                        <ComboBoxItem Content="Ciocana"/>
                        <ComboBoxItem Content="Râșcani"/>
                        <ComboBoxItem Content="Buiucani"/>
                        <ComboBoxItem Content="Botanica"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="7" Margin="80,8,80,0">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Anulare"
                        Click="anulare_click"
                        HorizontalAlignment="Left"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Adăugați"
                        HorizontalAlignment="Right"/>
            </Grid>

            <Image Grid.Row="8"
         Source="/Assets/bottom-img.png"
Stretch="Uniform"
HorizontalAlignment="Center"/>

        </Grid>
    </ScrollViewer>
</Window>