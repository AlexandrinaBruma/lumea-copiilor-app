<Window x:Class="LumeaCopiilor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LumeaCopiilor"
        mc:Ignorable="d"
        Title="Lumea Copiilor"
        WindowState="Maximized"
        Background="{StaticResource LightColor}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="80,0,40,0">

            <TextBlock Style="{StaticResource H1}"
                       Text="Bine ați venit la Lumea Copiilor"
                       TextWrapping="Wrap"/>

            <TextBlock Style="{StaticResource P}"
                       Text="Pentru a continua intrați în contul dumneavoastră."
                       TextWrapping="Wrap"
                       Margin="0,24,0,40"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Ieșire"
                        Margin="0,0,16,0"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Intră în cont"
                        Click="Button_Click"/>
            </StackPanel>

        </StackPanel>

        <Image Grid.Column="1"
               Source="/Assets/hero.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

    </Grid>
</Window>