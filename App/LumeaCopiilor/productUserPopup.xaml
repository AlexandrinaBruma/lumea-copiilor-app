<Window x:Class="LumeaCopiilor.productUserPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MaxWidth="720"
        MaxHeight="700"
        SizeToContent="Width"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource LightColor}"
            CornerRadius="16"
            Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <Grid Margin="0,34,0,34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource H1}"
                               Text="Detalii produs"
                               FontSize="40"
                               LineHeight="22"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nume" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NameValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Vârsta minimă" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MinAgeValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Vârsta maximă" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MaxAgeValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Data fabricației" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ManufactureDateValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Data expirării" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ExpiryDateValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Preț" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="PriceValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Țara de origine" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="CountryValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Importator" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="ImporterValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Magazine disponibile" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="StoresValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Cantitate" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" x:Name="QuantityValue" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Înapoi"
                            Margin="0,0,16,0"
                            Click="Button_Click"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Comandă"
                            Click="Button_Click_1"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
