<Window x:Class="LumeaCopiilor.ImportatorPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="xctk"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MaxWidth="720"
        MaxHeight="700"
        SizeToContent="Width"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource LightColor}"
            CornerRadius="16"
            Padding="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <Grid Margin="0,0,0,34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ImportatorIdTitle"
                               Grid.Column="0"
                               Style="{StaticResource H1}"
                               Text="Importator ID"
                               FontSize="40"
                               LineHeight="22"/>
                    <Button x:Name="EditButton"
                            Grid.Column="1"
                            Style="{StaticResource TertiaryButton}"
                            Content="Editare"
                            Height="36"
                            Padding="16,0"
                            VerticalAlignment="Center"
                            Click="EditButton_Click"/>
                </Grid>

                <Grid x:Name="FieldsGrid" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Company Name -->
                    <TextBlock x:Name="LblName" Grid.Row="0" Grid.Column="0" Text="Numele companiei" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="NameValue" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <TextBox   x:Name="NameInput" Grid.Row="0" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,4,0,8" Visibility="Collapsed"/>

                    <!-- Contact Person -->
                    <TextBlock x:Name="LblContact" Grid.Row="1" Grid.Column="0" Text="Persoana de contact" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ContactPersonValue" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <TextBox   x:Name="ContactInput" Grid.Row="1" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,4,0,8" Visibility="Collapsed"/>

                    <!-- Phone -->
                    <TextBlock x:Name="LblPhone" Grid.Row="2" Grid.Column="0" Text="Telefon" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="PhoneValue" Grid.Row="2" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <TextBox   x:Name="PhoneInput" Grid.Row="2" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,4,0,8" Visibility="Collapsed"/>

                    <!-- Email -->
                    <TextBlock x:Name="LblEmail" Grid.Row="3" Grid.Column="0" Text="Email" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="EmailValue" Grid.Row="3" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <TextBox   x:Name="EmailInput" Grid.Row="3" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,4,0,8" Visibility="Collapsed"/>

                    <!-- Website -->
                    <TextBlock x:Name="LblWebsite" Grid.Row="4" Grid.Column="0" Text="Website" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="WebsiteValue" Grid.Row="4" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <TextBox   x:Name="WebsiteInput" Grid.Row="4" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,4,0,8" Visibility="Collapsed"/>

                    <!-- City (FK) -->
                    <TextBlock x:Name="LblCity" Grid.Row="5" Grid.Column="0" Text="Oraș" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="CityValue" Grid.Row="5" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <ComboBox  x:Name="CityInput" Grid.Row="5" Grid.Column="1"
                               Style="{StaticResource ComboBoxStyle}"
                               DisplayMemberPath="DisplayName"
                               SelectedValuePath="CityID"
                               Margin="0,4,0,8" Visibility="Collapsed"/>

                    <!-- Street Address -->
                    <TextBlock x:Name="LblAddress" Grid.Row="6" Grid.Column="0" Text="Adresă" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="AddressValue" Grid.Row="6" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <TextBox   x:Name="AddressInput" Grid.Row="6" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,4,0,8" Visibility="Collapsed"/>

                    <!-- Fiscal Code -->
                    <TextBlock x:Name="LblFiscal" Grid.Row="7" Grid.Column="0" Text="Cod fiscal" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="FiscalCodeValue" Grid.Row="7" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <TextBox   x:Name="FiscalInput" Grid.Row="7" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="0,4,0,8" Visibility="Collapsed"/>

                    <!-- Contract Start Date -->
                    <TextBlock x:Name="LblStartDate" Grid.Row="8" Grid.Column="0" Text="Start contract" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="StartDateValue" Grid.Row="8" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <Border x:Name="StartDateBorder" Grid.Row="8" Grid.Column="1"
                            BorderBrush="{StaticResource DarkColor}"
                            BorderThickness="1.5" CornerRadius="30"
                            Margin="0,4,0,8" Visibility="Collapsed">
                        <xctk:DateTimePicker x:Name="StartDateInput"/>
                    </Border>

                    <!-- Contract End Date -->
                    <TextBlock x:Name="LblEndDate" Grid.Row="9" Grid.Column="0" Text="Încheie contract" Style="{StaticResource P}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="EndDateValue" Grid.Row="9" Grid.Column="1" Text="-" Style="{StaticResource P}" Margin="0,0,0,12"/>
                    <Border x:Name="EndDateBorder" Grid.Row="9" Grid.Column="1"
                            BorderBrush="{StaticResource DarkColor}"
                            BorderThickness="1.5" CornerRadius="30"
                            Margin="0,4,0,8" Visibility="Collapsed">
                        <xctk:DateTimePicker x:Name="EndDateInput"/>
                    </Border>

                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0">
                    <Button x:Name="DeleteCancelButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Ștergere"
                            Margin="0,0,16,0"
                            Click="DeleteCancelButton_Click"/>
                    <Button x:Name="BackSaveButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Înapoi"
                            Click="BackSaveButton_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
