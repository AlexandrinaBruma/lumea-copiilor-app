<Application x:Class="LumeaCopiilor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LumeaCopiilor"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="xctk"
             StartupUri="HomeWindow.xaml">
    <Application.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="LightColor" Color="#FFFFF8"/>
        <SolidColorBrush x:Key="Peach" Color="#FF9A86"/>
        <SolidColorBrush x:Key="DarkColor" Color="#410000"/>
        <SolidColorBrush x:Key="Paragraph" Color="#733232"/>
        <SolidColorBrush x:Key="Placeholder" Color="#AC9292"/>
        <SolidColorBrush x:Key="Card" Color="#F5EAD6"/>
        

        <!-- FONTS -->
        <FontFamily x:Key="MainFont">Montserrat</FontFamily>

        <!-- H1 STYLE -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="90"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DarkColor}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="LineHeight" Value="110"/>
        </Style>

        <!-- PARAGRAPH -->
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="{StaticResource Paragraph}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="LineHeight" Value="50"/>
        </Style>
        
        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Peach}"/>
            <Setter Property="Foreground" Value="{StaticResource LightColor}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="32,16"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="30"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="#E8816E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
            </Setter>
        </Style>

        <!-- SECONDARY BUTTON -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Peach}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Peach}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="32,16"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border"
                                BorderBrush="{StaticResource Peach}"
                                BorderThickness="1.5"
                                CornerRadius="30"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#FFF0ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TERTIARY BUTTON -->
        <Style x:Key="TertiaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Peach}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Peach}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border"
                                BorderBrush="{StaticResource Peach}"
                                BorderThickness="0, 0, 0, 1.5"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#FFF0ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ADMIN DASHBOARD BUTTONS -->
        <Style x:Key="AdminButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Foreground" Value="{StaticResource DarkColor}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="32,16"/>
            <Setter Property="MinHeight" Value="150"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background" Value="#EAD8BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTBOX STYLE -->
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DarkColor}"/>
            <Setter Property="CaretBrush" Value="{StaticResource DarkColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="25">
                            <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATAGRID STYLE -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Card}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Card}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Paragraph}"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="ColumnHeaderHeight" Value="48"/>
        </Style>

        <!-- DATAGRID HEADER STYLE -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Placeholder}"/>
            <Setter Property="Foreground" Value="{StaticResource LightColor}"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- DATAGRID ROW STYLE -->
        <Style TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="{StaticResource Card}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>

        <!-- DATAGRID CELL STYLE -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Paragraph}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Card}"/>
                    <Setter Property="Foreground" Value="{StaticResource Placeholder}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- CARD STYLE -->
        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- INPUT STYLE -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource DarkColor}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkColor}"/>
            <Setter Property="Background" Value="{StaticResource LightColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource Peach}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="30">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Peach}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Peach}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource DarkColor}"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkColor}"/>
            <Setter Property="Background" Value="{StaticResource LightColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <!-- BORDER PRINCIPAL -->
                            <Border Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="30"/>

                            <!-- TEXT SELECTAT -->
                            <ContentPresenter Grid.Column="0"
                                              x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>

                            <!-- SAGETA DROPDOWN -->
                            <ToggleButton Grid.Column="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <TextBlock Text="▼" 
                                           FontSize="11" 
                                           Foreground="{StaticResource Placeholder}" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center"/>
                            </ToggleButton>

                            <!-- POPUP CU OPTIUNI -->
                            <Popup Grid.ColumnSpan="2"
                                   x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   Margin="0,4,0,0">
                                <Border Background="{StaticResource LightColor}"
                                        BorderBrush="{StaticResource Placeholder}"
                                        BorderThickness="1.5"
                                        CornerRadius="8">
                                    <ScrollViewer SnapsToDevicePixels="True" MaxHeight="250">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- TRIGGERS PENTRU FOCUS/HOVER -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Peach}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Peach}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- STIL PENTRU COMBOBOXITEM -->
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="16,12"/>
                    <Setter Property="Foreground" Value="{StaticResource Paragraph}"/>
                    <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Card}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Peach}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Card}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- DATETIMEPICKER STYLE (înlocuiește cel existent) -->
        <Style TargetType="{x:Type xctk:DateTimePicker}">
            <Setter Property="FontFamily"               Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize"                 Value="16"/>
            <Setter Property="Foreground"               Value="{StaticResource DarkColor}"/>
            <Setter Property="MinHeight"                Value="60"/>
            <Setter Property="Padding"                  Value="16,0"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Background"               Value="{StaticResource LightColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TimePickerVisibility"     Value="Collapsed"/>
            <Setter Property="Format"                   Value="Custom"/>
            <Setter Property="FormatString"             Value="dd/MM/yyyy"/>
            <Setter Property="TextAlignment"            Value="Left"/>
        </Style>

        <!-- INTEGER UP-DOWN STYLE -->
        <Style TargetType="{x:Type xctk:IntegerUpDown}">
            <Setter Property="FontFamily"               Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize"                 Value="16"/>
            <Setter Property="Foreground"               Value="{StaticResource DarkColor}"/>
            <Setter Property="Background"               Value="{StaticResource LightColor}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource DarkColor}"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="MinHeight"                Value="60"/>
            <Setter Property="Padding"                  Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type xctk:IntegerUpDown}">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <xctk:WatermarkTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               VerticalAlignment="Center"
                                               Padding="{TemplateBinding Padding}"
                                               CaretBrush="{StaticResource DarkColor}"/>
                                <xctk:ButtonSpinner x:Name="PART_Spinner"
                                            Grid.Column="1"
                                            Width="28"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            BorderThickness="0"
                                            Background="Transparent"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DECIMAL UP-DOWN STYLE -->
        <Style TargetType="{x:Type xctk:DecimalUpDown}">
            <Setter Property="FontFamily"               Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize"                 Value="16"/>
            <Setter Property="Foreground"               Value="{StaticResource DarkColor}"/>
            <Setter Property="Background"               Value="{StaticResource LightColor}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource DarkColor}"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="MinHeight"                Value="60"/>
            <Setter Property="Padding"                  Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type xctk:DecimalUpDown}">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <xctk:WatermarkTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               VerticalAlignment="Center"
                                               Padding="{TemplateBinding Padding}"
                                               CaretBrush="{StaticResource DarkColor}"/>
                                <xctk:ButtonSpinner x:Name="PART_Spinner"
                                            Grid.Column="1"
                                            Width="28"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            BorderThickness="0"
                                            Background="Transparent"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Application.Resources>
</Application>
